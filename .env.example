# Asignaciones de GNU Make, cargadas por el Makefile raíz.
# Sobrescribe solo lo que sea distinto en tu entorno local.

PROJECT_ROOT ?= $(CURDIR)
ARTIFACTS_DIR ?= $(PROJECT_ROOT)/artifacts
CONFIGS_DIR ?= $(PROJECT_ROOT)/configs
SSH_PUBLIC_KEY_DIR ?= $(CONFIGS_DIR)/ssh
SSH_PRIVATE_KEY_DIR ?= $(HOME)/.ssh

ROUTEROS_VERSION ?= 7.21.4
ROUTEROS_VDI_FILENAME ?= chr-$(ROUTEROS_VERSION).vdi
ROUTEROS_VDI_PATH ?= $(ARTIFACTS_DIR)/images/chr/$(ROUTEROS_VDI_FILENAME)
ROUTEROS_BOX_NAME ?= routeros-base
ROUTEROS_BOX_FILE ?= $(ARTIFACTS_DIR)/images/chr/$(ROUTEROS_BOX_NAME).box

VBOX_ROOT_GROUP ?= /VirtualCorp
VM_ROUTERS_GROUP ?= $(VBOX_ROOT_GROUP)/Routers
VM_TEMPLATES_GROUP ?= $(VBOX_ROOT_GROUP)/templates
# Configura esta variable solo si VirtualBox está fuera del PATH o tiene otro nombre.
# VBOXMANAGE_BIN ?= /ruta/a/VBoxManage

# --- Versiones fijas de las imágenes de sistema operativo ---
DEBIAN_VERSION ?= 13.7.0
DEBIAN_ISO_FILENAME ?= debian-$(DEBIAN_VERSION)-amd64-netinst.iso
DEBIAN_ISO_URL ?= https://cdimage.debian.org/debian-cd/$(DEBIAN_VERSION)/amd64/iso-cd/$(DEBIAN_ISO_FILENAME)
DEBIAN_ISO_SHA256 ?= a7ef94ac2fb9a7fec454552abd629b7cc9d5155c886165a45649f5ce6167e355
DEBIAN_ISO_PATH ?= $(ARTIFACTS_DIR)/images/debian/$(DEBIAN_ISO_FILENAME)

PROXMOX_VERSION ?= 9.2-1
PROXMOX_ISO_FILENAME ?= proxmox-ve_$(PROXMOX_VERSION).iso
PROXMOX_ISO_URL ?= https://download.proxmox.com/iso/$(PROXMOX_ISO_FILENAME)
PROXMOX_ISO_SHA256 ?= 4e88fe416df9b527624a175f24c9aa07c714d3332afb1ee3dbf3879573ef2c6c
PROXMOX_ISO_PATH ?= $(ARTIFACTS_DIR)/images/proxmox/$(PROXMOX_ISO_FILENAME)
PROXMOX_AUTO_ISO_PATH ?= $(ARTIFACTS_DIR)/images/proxmox/proxmox-ve_$(PROXMOX_VERSION)-auto.iso

# --- Herramientas locales de compilación (se descargan en artifacts/tools si faltan) ---
VCORP_TOOLS_DIR ?= $(ARTIFACTS_DIR)/tools
PVE_ASSISTANT_VERSION ?= 9.2.1
PVE_ASSISTANT_URL ?= https://aptly.lf.net/nightly/debian-13-proxmox/pool/pve-no-subscription/p/proxmox-installer/proxmox-auto-install-assistant_$(PVE_ASSISTANT_VERSION)_amd64.deb

# --- Templates Debian ---
DEBIAN_SERVER_TEMPLATE ?= debian-server-template
DEBIAN_DESKTOP_TEMPLATE ?= debian-desktop-template
TEMPLATE_SSH_PORT_SERVER ?= 2220
TEMPLATE_SSH_PORT_DESKTOP ?= 2221
TEMPLATE_USER ?= sysadmin
TEMPLATE_SERVER_CPU ?= 1
TEMPLATE_SERVER_MEMORY ?= 1024
TEMPLATE_SERVER_DISK_MB ?= 10240
TEMPLATE_DESKTOP_CPU ?= 2
TEMPLATE_DESKTOP_MEMORY ?= 2048
TEMPLATE_DESKTOP_DISK_MB ?= 20480

# --- Despliegue del equipamiento ---
VBOX_BASEFOLDER ?= $(HOME)/VirtualBox VMs
VM_SERVERS_GROUP ?= $(VBOX_ROOT_GROUP)/Servers
VM_PRINTERS_GROUP ?= $(VBOX_ROOT_GROUP)/Printers
VM_DESKTOPS_GROUP ?= $(VBOX_ROOT_GROUP)/Desktops
VM_DIRECTION_GROUP ?= $(VBOX_ROOT_GROUP)/Direction
EQUIPMENT_INVENTORY ?= $(CONFIGS_DIR)/inventory/equipment.csv

# --- pve01 ---
PVE01_NAME ?= pve01
PVE01_CPU ?= 4
PVE01_MEMORY ?= 8192
PVE01_DISK_MB ?= 65536
PVE01_IP ?= 10.22.0.133/26
PVE01_GATEWAY ?= 10.22.0.129
PVE01_DNS ?= 1.1.1.1
PVE01_NETWORK ?= privada
PVE01_TEMP_SSH_PORT ?= 2222

# --- Claves públicas SSH autorizadas dentro de los templates ---
TEMPLATE_AUDITOR_KEY ?= $(SSH_PUBLIC_KEY_DIR)/vcorp-auditor.pub
TEMPLATE_SYSADMIN_KEY ?= $(SSH_PUBLIC_KEY_DIR)/vcorp_sysadmin.pub
