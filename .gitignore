
# ============================================================
# VirtualCorp - Bash, Ansible, Terraform y VirtualBox
# ============================================================

# ------------------------------------------------------------
# Sistema operativo y editores
# ------------------------------------------------------------

*~
*.swp
*.swo
*.bak
.DS_Store
Thumbs.db
.directory

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains
.idea/

# ------------------------------------------------------------
# Bash: temporales, depuración y salidas
# ------------------------------------------------------------

*.log
*.tmp
*.temp
*.pid
*.seed
core
core.*

# Ficheros temporales creados por scripts
/tmp/
/temp/
/.cache/

# Resultados generados (adapta los nombres a la estructura real)
logs/
reports/
output/
*.out

# ------------------------------------------------------------
# Ansible
# ------------------------------------------------------------

# Ficheros de salida y temporales
*.retry
.retry/
ansible.log

# Inventarios locales generados
inventory/local
inventory/local.*
inventory/generated/
inventories/local/
inventories/generated/

# Variables locales y secretos
vault-password-file
.vault-password
.vault_pass
group_vars/*/vault.yml
host_vars/*/vault.yml

# Credenciales SSH
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa
known_hosts

# ------------------------------------------------------------
# Terraform
# ------------------------------------------------------------

# Directorios de trabajo
**/.terraform/*
.terraform/

# Ficheros de estado
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.*

# Copias de seguridad del estado
*.backup
*.tfstate.backup

# Ficheros de variables locales
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Excepción: plantillas de ejemplo sin secretos
!*.example.tfvars
!*.example.tfvars.json

# Ficheros de configuración local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Planes y salidas de Terraform
*.tfplan
tfplan
crash.log
crash.*.log

# Fichero de bloqueo: NO ignorar .terraform.lock.hcl
# Hay que versionarlo para fijar las versiones de los proveedores.

# ------------------------------------------------------------
# VirtualBox
# ------------------------------------------------------------

# Máquinas virtuales y discos
*.vdi
*.vmdk
*.vhd
*.vhdx
*.vbox
*.vbox-prev
*.ova
*.ovf
*.qcow2
*.img

# Instantáneas, estado guardado y memoria
*.sav
*.vbox-tmp
Snapshots/

# Ficheros de bloqueo
*.lck
*.lock

# Configuraciones locales de VirtualBox
VirtualBox.xml
VBoxSVC.log
VBox.log
VBox.log.*

# ------------------------------------------------------------
# Imágenes, ISOs y artefactos generados
# ------------------------------------------------------------

*.iso
*.box
*.qcow
build/
dist/

# 1. Ignora todos los archivos en cualquier nivel de la estructura
artifacts/**/.*
artifacts/**/*

# 2. Permite que Git entre en las subcarpetas para buscar archivos
!artifacts/**/

# 3. Exceptúa los archivos .gitkeep que mantendrán las carpetas vivas
!artifacts/**/.gitkeep

# ------------------------------------------------------------
# Secretos y credenciales
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.secret
*.secrets
secrets.yml
secrets.yaml
credentials.json
credentials.yml
credentials.yaml

# Claves y certificados privados
*.p12
*.pfx
*.crt
*.cer
*.pubkey

# Copias de seguridad y material sensible del laboratorio
/SSH-keys/
/VirtualBox-VMs/
/*.tar
/*.tar.gz
/*.tar.zst
/*.zip
*.zst

# ------------------------------------------------------------
# Datos locales de desarrollo y pruebas
# ------------------------------------------------------------

.local/
.cache/
.pytest_cache/
__pycache__/
*.py[cod]
venv/
.venv/

